   "additionalProperties": false,
   "properties": {
    "left": {
     "default": false,
     "title": "Left",
     "type": "boolean"
    },
    "right": {
     "default": false,
     "title": "Right",
     "type": "boolean"
    },
    "top": {
     "default": false,
     "title": "Top",
     "type": "boolean"
    },
    "bottom": {
     "default": false,
     "title": "Bottom",
     "type": "boolean"
    }
   },
   "title": "Truncated",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "schema": {
   "enum": [
    "mg.obsset.vs01",
    "mg.obsset.live.vs02"
   ],
