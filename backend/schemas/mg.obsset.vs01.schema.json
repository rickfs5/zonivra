    "frame_table_digest",
    "frame_count",
    "width",
    "height",
    "native_width",
    "native_height"
   ],
   "title": "SourceBinding",
   "type": "object"
  },
  "StatusRange": {
   "additionalProperties": false,
   "properties": {
    "from_frame": {
     "title": "From Frame",
     "type": "integer"
    },
    "to_frame": {
     "title": "To Frame",
     "type": "integer"
    },
    "status": {
     "enum": [
      "not_analyzed_stride",
      "not_analyzed_dropped",
      "source_gap",
      "adapter_error"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "from_frame",
    "to_frame",
    "status"
   ],
