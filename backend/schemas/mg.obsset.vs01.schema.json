     "type": "string"
    },
    "model_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Model Id"
    },
    "weights_sha256": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Weights Sha256"
    },
    "params_hash": {
     "title": "Params Hash",
     "type": "string"
    },
    "label_map_digest": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Label Map Digest"
    },
    "params": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "string"
       },
       {
        "type": "boolean"
       }
      ]
     },
     "title": "Params",
     "type": "object"
    }
   },
   "required": [
    "adapter_id",
    "adapter_version",
    "model_id",
    "weights_sha256",
    "params_hash",
    "label_map_digest",
    "params"
   ],
   "title": "Producer",
   "type": "object"
  },
  "SourceBinding": {
   "additionalProperties": false,
   "properties": {
    "source_digest": {
     "title": "Source Digest",
     "type": "string"
    },
    "frame_table_digest": {
     "title": "Frame Table Digest",
     "type": "string"
    },
    "frame_count": {
     "minimum": 1,
     "title": "Frame Count",
     "type": "integer"
    },
    "width": {
     "minimum": 1,
     "title": "Width",
     "type": "integer"
    },
    "height": {
     "minimum": 1,
     "title": "Height",
     "type": "integer"
    },
    "native_width": {
     "minimum": 1,
     "title": "Native Width",
     "type": "integer"
    },
    "native_height": {
     "minimum": 1,
     "title": "Native Height",
     "type": "integer"
    }
   },
   "required": [
