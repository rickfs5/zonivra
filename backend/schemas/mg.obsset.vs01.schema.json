   "const": "mg.cls.v0",
   "title": "Taxonomy",
   "type": "string"
  },
  "origin": {
   "enum": [
    "synthetic_scripted",
    "human_annotated",
    "model_inference"
   ],
   "title": "Origin",
   "type": "string"
  },
  "producer": {
   "$ref": "#/$defs/Producer"
  },
  "tracks": {
   "default": [],
   "items": {
    "additionalProperties": true,
    "type": "object"
   },
   "maxItems": 0,
   "title": "Tracks",
   "type": "array"
  },
  "frames": {
   "items": {
    "$ref": "#/$defs/Frame"
   },
   "title": "Frames",
   "type": "array"
  },
  "frame_status_ranges": {
   "items": {
    "$ref": "#/$defs/StatusRange"
   },
   "title": "Frame Status Ranges",
   "type": "array"
  },
  "meta": {
   "$ref": "#/$defs/Meta",
   "default": {
    "created_utc": null,
    "tool": null,
    "notes": null,
    "provenance_id": null,
    "elapsed_ms": null,
    "dropped_degenerate_boxes": null
   }
  }
 },
 "required": [
  "schema",
  "source_binding",
  "coord_space",
  "taxonomy",
  "origin",
  "producer",
  "frames",
  "frame_status_ranges"
 ],
 "title": "ObservationSet",
 "type": "object"
}
