{
 "$defs": {
  "Bbox": {
   "additionalProperties": false,
   "properties": {
    "x": {
     "title": "X",
     "type": "integer"
    },
    "y": {
     "title": "Y",
     "type": "integer"
    },
    "w": {
     "title": "W",
     "type": "integer"
    },
    "h": {
     "title": "H",
     "type": "integer"
    }
   },
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "title": "Bbox",
   "type": "object"
  },
  "Cls": {
   "additionalProperties": false,
   "properties": {
    "label": {
     "enum": [
      "person",
      "vehicle",
      "other"
     ],
     "title": "Label",
     "type": "string"
    },
    "state": {
     "const": "known",
     "title": "State",
     "type": "string"
    },
    "detector_label": {
     "title": "Detector Label",
     "type": "string"
    },
    "detector_class_id": {
     "title": "Detector Class Id",
     "type": "integer"
    }
   },
   "required": [
    "label",
    "state",
    "detector_label",
    "detector_class_id"
   ],
   "title": "Cls",
   "type": "object"
  },
  "Confidence": {
   "additionalProperties": false,
   "properties": {
    "permille": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Permille"
    },
    "kind": {
     "enum": [
      "not_applicable",
      "human_asserted",
      "model_uncalibrated",
      "model_calibrated"
     ],
     "title": "Kind",
     "type": "string"
    }
   },
   "required": [
    "permille",
    "kind"
   ],
   "title": "Confidence",
   "type": "object"
  },
  "Frame": {
   "additionalProperties": false,
   "properties": {
    "frame_index": {
     "minimum": 0,
     "title": "Frame Index",
     "type": "integer"
    },
    "status": {
     "const": "analyzed",
     "title": "Status",
     "type": "string"
    },
    "pixel_sha256": {
     "title": "Pixel Sha256",
     "type": "string"
    },
    "objects": {
     "items": {
      "$ref": "#/$defs/Obj"
     },
     "title": "Objects",
     "type": "array"
    }
   },
   "required": [
    "frame_index",
    "status",
    "pixel_sha256",
    "objects"
   ],
   "title": "Frame",
   "type": "object"
  },
  "Meta": {
   "additionalProperties": false,
   "description": "Unhashed metadata. Strict (MG-DATA-001 section 5 lists creation time, tool, notes, provenance_id); VS-01 adds two counters.",
   "properties": {
    "created_utc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Created Utc"
    },
    "tool": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Tool"
    },
    "notes": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Notes"
    },
    "provenance_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Provenance Id"
    },
    "elapsed_ms": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Elapsed Ms"
    },
    "dropped_degenerate_boxes": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Dropped Degenerate Boxes"
    }
   },
   "title": "Meta",
   "type": "object"
  },
  "Obj": {
   "additionalProperties": false,
   "properties": {
    "obj_key": {
     "pattern": "^[A-Za-z0-9_-]{1,32}$",
     "title": "Obj Key",
     "type": "string"
    },
    "cls": {
     "$ref": "#/$defs/Cls"
    },
    "bbox": {
     "$ref": "#/$defs/Bbox"
    },
    "truncated": {
     "$ref": "#/$defs/Truncated"
    },
    "confidence": {
     "$ref": "#/$defs/Confidence"
    },
    "track_ref": {
     "default": null,
     "title": "Track Ref",
     "type": "null"
    }
   },
   "required": [
    "obj_key",
    "cls",
    "bbox",
    "truncated",
    "confidence"
   ],
   "title": "Obj",
   "type": "object"
  },
